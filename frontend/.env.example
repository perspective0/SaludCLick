# Frontend environment
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=https://salud-c-lick.vercel.app
# Optional: URL absoluta del API usada para renderizar médicos en SEO.
# Si NEXT_PUBLIC_API_URL ya es absoluta en producción, no hace falta definirla.
SEO_API_URL=
# Código de verificación de Google Search Console, sin la etiqueta HTML.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_APP_NAME=SaludClick
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# WebRTC TURN (recomendado para teleconsulta interna en produccion)
# NEXT_PUBLIC_TURN_URLS=turn:turn.tudominio.com:3478,turns:turn.tudominio.com:5349
# NEXT_PUBLIC_TURN_USERNAME=usuario
# NEXT_PUBLIC_TURN_CREDENTIAL=clave

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
